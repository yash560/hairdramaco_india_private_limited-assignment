# ==========================================
# Hairdrama FlowOS Environment Configuration
# ==========================================

# Database - Supabase Configuration
# Obtain from your Supabase project dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Authentication - Google OAuth 2.0
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Email Notification Integration - Gmail SMTP / App Passwords
# In your Google Account: Security -> 2-Step Verification -> App Passwords
GMAIL_USER=notifications@hairdramaco.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# Backend - Flask Configuration
FLASK_ENV=production
FLASK_PORT=5000
JWT_SECRET=super-secret-jwt-signing-key-hairdramaco-2026
CORS_ORIGINS=http://localhost:3000,https://hairdramaco-taskflow.vercel.app

# API Endpoint URL (for frontend communication)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
